# CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
# AI_MAX_PARALEL=4              # aynı anda kaç ilan analiz edilsin
# PLAYWRIGHT_CHROMIUM_PATH=     # sistemdeki Chrome/Chromium yolunu kullanmak isterseniz
